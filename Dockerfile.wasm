FROM emscripten/emsdk:3.1.74

# g++-multilib: i386 libstdc++ for the native-clang-32* presets (V2, V2S). CMake via pip because the image ships 3.22
# and the project requires 3.25+.
RUN apt-get update \
  && apt-get install -y --no-install-recommends make g++ g++-multilib binutils python3-pip \
  && rm -rf /var/lib/apt/lists/* \
  && pip install --no-cache-dir cmake==3.30.5

WORKDIR /app
ENV OLY_TOOLCHAIN=wasm

# The emsdk LLVM is the same as Emscripten's and already has the x86-64 target: it serves as the native Clang (V1/V2/VX).
RUN /emsdk/upstream/bin/clang++ --print-targets | grep -q x86-64 \
  && ln -s /emsdk/upstream/bin/clang++ /usr/local/bin/clang++

# The emsdk entrypoint puts /emsdk/upstream/emscripten on the PATH, and there is a "cmake" directory there that make
# (direct exec) mistakes for the executable (EACCES). /emsdk comes earlier on the PATH, so the link resolves it.
RUN ln -s /usr/local/bin/cmake /emsdk/cmake

FROM emscripten/emsdk:3.1.74

# g++-multilib: libstdc++ i386 para os presets native-clang-32* (V2, V2S). CMake via pip porque a imagem traz o 3.22
# e o projeto exige 3.25+.
RUN apt-get update \
  && apt-get install -y --no-install-recommends make g++ g++-multilib binutils python3-pip \
  && rm -rf /var/lib/apt/lists/* \
  && pip install --no-cache-dir cmake==3.30.5

WORKDIR /app

# O LLVM do emsdk é o mesmo do Emscripten e já tem o alvo x86-64: serve de Clang nativo (V1/V2/VX).
RUN /emsdk/upstream/bin/clang++ --print-targets | grep -q x86-64 \
  && ln -s /emsdk/upstream/bin/clang++ /usr/local/bin/clang++

# O entrypoint do emsdk põe /emsdk/upstream/emscripten no PATH, e lá há um diretório "cmake" que o make
# (exec direto) confunde com o executável (EACCES). /emsdk vem antes no PATH, então o link resolve.
RUN ln -s /usr/local/bin/cmake /emsdk/cmake

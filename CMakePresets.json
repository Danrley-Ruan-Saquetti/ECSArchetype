{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base", "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_CXX_STANDARD": "20", "OLY_WERROR": "ON" }
    },
    {
      "name": "debug-asan", "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug", "OLY_SANITIZE": "ON",
        "OLY_BUILD_TESTS": "ON", "OLY_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "release", "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release", "OLY_SANITIZE": "OFF",
        "OLY_BUILD_TESTS": "ON", "OLY_BUILD_BENCH": "ON", "OLY_ENABLE_ASSERTS": "0"
      }
    },
    {
      "name": "relwithdebinfo", "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo", "OLY_SANITIZE": "OFF",
        "OLY_BUILD_TESTS": "OFF", "OLY_BUILD_BENCH": "ON", "OLY_ENABLE_ASSERTS": "0"
      }
    },
    {
      "name": "schema-tool", "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release", "OLY_SANITIZE": "OFF", "OLY_WERROR": "OFF",
        "OLY_BUILD_TESTS": "OFF", "OLY_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "variant", "hidden": true, "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release", "OLY_SANITIZE": "OFF",
        "OLY_BUILD_TESTS": "ON", "OLY_BUILD_BENCH": "ON", "OLY_ENABLE_ASSERTS": "0",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "variant-clang", "hidden": true, "inherits": "variant",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "variant-wasm", "hidden": true, "inherits": "variant",
      "toolchainFile": "/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_EXE_LINKER_FLAGS": "--profiling-funcs" }
    },
    {
      "name": "native-clang", "inherits": "variant-clang"
    },
    {
      "name": "native-clang-32", "inherits": "variant-clang",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-m32", "CMAKE_EXE_LINKER_FLAGS": "-m32" }
    },
    {
      "name": "native-clang-32-scalar", "inherits": "variant-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -fno-vectorize -fno-slp-vectorize",
        "CMAKE_EXE_LINKER_FLAGS": "-m32"
      }
    },
    {
      "name": "native-clang-avx2", "inherits": "variant-clang",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-mavx2 -mfma" }
    },
    {
      "name": "wasm-scalar", "inherits": "variant-wasm"
    },
    {
      "name": "wasm-simd", "inherits": "variant-wasm",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-msimd128" }
    },
    {
      "name": "wasm-debug", "inherits": "base",
      "toolchainFile": "/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug", "OLY_SANITIZE": "OFF",
        "OLY_BUILD_TESTS": "ON", "OLY_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "wasm-games", "inherits": "wasm-debug",
      "cacheVariables": { "OLY_BUILD_GAMES": "ON" }
    },
    {
      "name": "wasm-games-release", "inherits": "wasm-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release", "OLY_ENABLE_ASSERTS": "0", "OLY_BUILD_GAMES": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug-asan", "configurePreset": "debug-asan" },
    { "name": "release", "configurePreset": "release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "schema-tool", "configurePreset": "schema-tool", "targets": ["oly-schema"] },
    { "name": "native-clang", "configurePreset": "native-clang" },
    { "name": "native-clang-32", "configurePreset": "native-clang-32" },
    { "name": "native-clang-32-scalar", "configurePreset": "native-clang-32-scalar" },
    { "name": "native-clang-avx2", "configurePreset": "native-clang-avx2" },
    { "name": "wasm-scalar", "configurePreset": "wasm-scalar" },
    { "name": "wasm-simd", "configurePreset": "wasm-simd" },
    { "name": "wasm-debug", "configurePreset": "wasm-debug" },
    { "name": "wasm-games", "configurePreset": "wasm-games" },
    { "name": "wasm-games-release", "configurePreset": "wasm-games-release" }
  ],
  "testPresets": [
    { "name": "debug-asan", "configurePreset": "debug-asan", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "native-clang", "configurePreset": "native-clang", "output": { "outputOnFailure": true } },
    { "name": "native-clang-32", "configurePreset": "native-clang-32", "output": { "outputOnFailure": true } },
    { "name": "native-clang-32-scalar", "configurePreset": "native-clang-32-scalar", "output": { "outputOnFailure": true } },
    { "name": "native-clang-avx2", "configurePreset": "native-clang-avx2", "output": { "outputOnFailure": true } },
    { "name": "wasm-scalar", "configurePreset": "wasm-scalar", "output": { "outputOnFailure": true } },
    { "name": "wasm-simd", "configurePreset": "wasm-simd", "output": { "outputOnFailure": true } },
    { "name": "wasm-debug", "configurePreset": "wasm-debug", "output": { "outputOnFailure": true } },
    { "name": "wasm-games", "configurePreset": "wasm-games", "output": { "outputOnFailure": true } },
    { "name": "wasm-games-release", "configurePreset": "wasm-games-release", "output": { "outputOnFailure": true } }
  ]
}

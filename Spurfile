_fail() {
  printf 'spur %s: %s\n' "$SPUR_TASK" "$2" >&2
  exit "$1"
}

_image_for() {
  case $1 in
    wasm* | native-clang* | schema-tool) echo wasm ;;
    *) echo dev ;;
  esac
}

_require_games_preset() {
  case $1 in
    wasm-games*) ;;
    *) _fail 64 "needs a wasm-games* preset (got: $1)" ;;
  esac
}

_require_game() {
  [ -n "${1:-}" ] || _fail 64 "usage: ./spur $SPUR_TASK <game>"
}

_esbuild() {
  _game=$1
  shift
  node_modules/.bin/esbuild "games/$_game/web/dist/src/main.js" --bundle --format=esm --platform=browser --target=es2022 "$@"
}

# _in IMAGE [--service SERVICE] [compose run options...] -- [task args...]
# Returns when this is the IMAGE toolchain; on the host, re-runs the task in
# the compose service. The compose options must end up before the service, and
# the task arguments after it, with no word splitting.
_in() {
  _image=$1
  _service=$1
  shift
  if [ "${1:-}" = --service ]; then
    _service=$2
    shift 2
  fi

  if [ "${OLY_TOOLCHAIN:-}" = "$_image" ]; then
    return 0
  fi

  if [ -n "${OLY_TOOLCHAIN:-}" ]; then
    _fail 64 "runs in the $_image image, this is the $OLY_TOOLCHAIN image"
  fi

  # 69 stays outside spur's own 64-68.
  if ! command -v docker > /dev/null 2>&1; then
    _fail 69 "this image predates OLY_TOOLCHAIN and has no docker: run 'docker compose build' on the host"
  fi

  _options=0
  while [ "$1" != -- ]; do
    set -- "$@" "$1"
    shift
    _options=$((_options + 1))
  done
  shift

  set -- "$_service" ./spur "$SPUR_TASK" "$@"
  _rotate=$(($# - _options))
  while [ "$_rotate" -gt 0 ]; do
    set -- "$@" "$1"
    shift
    _rotate=$((_rotate - 1))
  done

  # Git Bash would rewrite arguments such as '^ecs\.' as Windows paths.
  export MSYS_NO_PATHCONV=1
  exec docker compose run --rm -e PRESET -e OLY_FUZZ_SEED -e OLY_FUZZ_OPS "$@"
}

configure: ## cmake --preset $PRESET (default debug-asan)
  preset=${PRESET:-debug-asan}
  _in "$(_image_for "$preset")" -- "$@"

  cmake --preset "$preset"

build: ## configure and build $PRESET (default debug-asan)
  preset=${PRESET:-debug-asan}
  _in "$(_image_for "$preset")" -- "$@"

  PRESET=$preset spur configure
  cmake --build --preset "$preset" -j

## Run ctest on $PRESET after building it; the arguments go to ctest.
##
##   ./spur test -R '^ecs\.'
test: ## build and run the tests of $PRESET (default debug-asan)
  preset=${PRESET:-debug-asan}
  _in "$(_image_for "$preset")" -- "$@"

  PRESET=$preset spur build
  ctest --preset "$preset" --no-tests=error "$@"

## Run a command in the dev container, or a shell.
##
##   ./spur dev ./build/release/bench/ecs_bench_iterate
##   ./spur dev ./spur -x test   # trace a task
dev: ## command or shell in the dev container
  _in dev -- "$@"

  [ "$#" -gt 0 ] || set -- bash
  exec "$@"

## Run a command in the wasm container, or a shell.
##
##   ./spur wasm node --version
wasm: ## command or shell in the wasm container
  _in wasm -- "$@"

  [ "$#" -gt 0 ] || set -- bash
  exec "$@"

schema-tool: ## build oly-schema for the machine
  _in wasm -- "$@"

  # Built for the machine: a WASM build cannot run the oly-schema it compiles. Only in the wasm image; native presets
  # build oly-schema with the tree.
  cmake --preset schema-tool
  cmake --build --preset schema-tool -j

ts: ## generate the schemas and build the TypeScript
  _in wasm -- "$@"

  spur schema-tool

  # The TS code imports the generated schemas, so they exist before tsc: a game's goes into its web/ package, a test
  # schema's next to its .oly.
  for web in games/*/web; do
    game=$(basename "$(dirname "$web")")
    build/schema-tool/bin/oly-schema "games/$game/$game.oly" --emit "ts=$web/schema.generated.ts"
  done
  for schema in $(find engine/testing -name '*.oly'); do
    build/schema-tool/bin/oly-schema "$schema" --emit "ts=${schema%.oly}.generated.ts"
  done

  # npm is the one next to node: in the emsdk image it is not on the PATH.
  npm="$(dirname "$(command -v node)")/npm"
  [ -d node_modules ] || "$npm" ci --no-audit --no-fund
  "$npm" run build

## Build the TypeScript and run ctest on a wasm-games* preset (default wasm-games).
##
##   PRESET=wasm-games-release ./spur games-test -R '^ts\.'
games-test: ## ts, then the tests of a wasm-games* preset
  preset=${PRESET:-wasm-games}
  _require_games_preset "$preset"
  _in wasm -- "$@"

  spur ts
  PRESET=$preset spur test "$@"

game: ## bundle a game into build/<preset>/web/<game>
  preset=${PRESET:-wasm-games-release}
  _require_game "$@"
  _require_games_preset "$preset"
  _in wasm -- "$@"

  spur ts
  PRESET=$preset spur build

  web_dir=build/$preset/web/$1
  mkdir -p "$web_dir"
  cp "games/$1/web/index.html" "$web_dir/"
  cp "build/$preset/games/$1_game.mjs" "build/$preset/games/$1_game.wasm" "$web_dir/"
  _esbuild "$1" --outfile="$web_dir/main.js"

## Bundle a game and serve it on http://localhost:8000. esbuild stops when stdin closes.
##
##   ./spur serve arena
serve: ## game, then serve it on port 8000
  preset=${PRESET:-wasm-games-release}
  _require_game "$@"
  _require_games_preset "$preset"
  _in wasm --service web --service-ports -- "$@"

  PRESET=$preset spur game "$1"
  web_dir=build/$preset/web/$1
  _esbuild "$1" --outfile="$web_dir/main.js" --servedir="$web_dir" --serve=0.0.0.0:8000
